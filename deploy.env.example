# Server settings for `docker compose --env-file deploy.env up -d --build` (docs/DEPLOY_AWS.md).
# Copy this file to deploy.env and fill it in. deploy.env is git-ignored: never commit it.

# Required on any server: a long random secret that signs staff logins. Make one with:  openssl rand -hex 32
# Left empty, the app falls back to the public development secret and logs a warning at start.
JWT_SECRET=

# Port on the server: 80 serves the site at http://<server address>/.
APP_PORT=80

# Database. Leave it commented out for SQLite in the Docker volume (simplest), or give an Amazon RDS PostgreSQL URL:
# DARKSTORE_DB=postgresql://USER:PASSWORD@your-db.xxxxxxxx.REGION.rds.amazonaws.com:5432/darkstore

# Reset demo data also refills 60 days of sales history, so forecasts, KPIs and the network map have data.
DEMO_HISTORY_ON_RESET=on

# Requests per second per client on the open customer endpoints (0 turns the limit off; only for a load test).
RATE_LIMIT_PER_SECOND=20

# Automatic replenishment every N minutes (0 = only when someone presses "Check what needs reordering").
REPLENISHMENT_INTERVAL_MINUTES=0

# Optional: require 'Authorization: Bearer <token>' on /metrics. Leave empty to keep /metrics open
# (the bundled Prometheus in docker-compose.yml scrapes it without a token).
METRICS_TOKEN=
