# Copy to .env.local (which git ignores) and restart `npx expo start`.

# The API the app talks to. Leave it out to run on built-in demo data (mock mode).
EXPO_PUBLIC_API_URL=https://staging.farm2home.galabavamsi.com

# Mock mode only. Shorten these to watch a hold run out or an order move faster.
# EXPO_PUBLIC_MOCK_HOLD_SECONDS=600
# EXPO_PUBLIC_MOCK_ORDER_STEP_SECONDS=12
